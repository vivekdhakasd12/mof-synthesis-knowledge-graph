# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Notebooks
.ipynb_checkpoints/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
