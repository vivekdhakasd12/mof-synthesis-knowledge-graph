.ruff_cache/

# Project-specific
.env
.env.*
!.env.example
# personal scratchpad, never committed (repo will be public)
MY_NOTES.md
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Third-party reference databases (DigiMOF SI, SynMOF). Their redistribution terms are the
# publishers', not ours, so a reader fetches them rather than receiving a copy from us.
# docs/data_sources.md records where they come from, and
# src/evaluation/build_reference_join.py rebuilds the merged file from them.
data/external/*
!data/external/.gitkeep
llm_cache/
*.log

# Outputs (large)
*.pdf
*.docx
!docs/*.docx
!docs/*.pdf
# The rendered report is a deliverable, not a build artefact: it is what a reader
# arriving at this repository actually wants to open.
!docs/report/*.pdf
!docs/report/*.html
# Tectonic's build log, which is regenerated on every compile.
docs/report/*.log

neo4j_data/
neo4j_logs/

# Office lock files (win over the docs/ un-ignore rules above)
~$*

# OS
Thumbs.db

# Local development tooling, not part of the project
.claude/
CLAUDE.md
MY_NOTES.md
